APP_ENV=production
APP_NAME=PS3 Health Record API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
REDIS_URL=rediss://default:PASSWORD@HOST:PORT
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-private-secret-store
SUPABASE_STORAGE_BUCKET=patient-documents
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ACCESS_TOKEN_MINUTES=15
WEB_ORIGINS=https://YOUR-VERCEL-DOMAIN.vercel.app
